{
	"name": "citomni/cli",
	"description": "High-performance CLI runtime for CitOmni apps: kernel boot glue, command runner, console dispatch, and CLI error handling.",
	"type": "library",
	"license": "MIT",
	"homepage": "https://github.com/citomni/cli",
	"keywords": [
		"citomni",
		"citomni-framework",
		"citomni-php",
		"php",
		"php8",
		"cli",
		"cli-app",
		"console",
		"php-cli",
		"php-cli-framework",
		"php-framework",
		"command-line",
		"command-runner",
		"kernel",
		"runtime",
		"deterministic",
		"high-performance",
		"low-overhead",
		"service-container",
		"green-coding"
	],
	"require": {
		"php": "^8.5",
		"citomni/kernel": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"CitOmni\\Cli\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"CitOmni\\Cli\\Tests\\": "tests/"
		}
	},
	"require-dev": {
		"phpunit/phpunit": "^11.0",
		"phpstan/phpstan": "^1.11"
	},
	"suggest": {
		"ext-json": "Faster JSON handling for CLI ErrorHandler JSONL logging",
		"ext-opcache": "Better performance and cache invalidation",
		"citomni/infrastructure": "Optional services used when present (log, txt/mail/db)"
	},
	"support": {
		"issues": "https://github.com/citomni/cli/issues",
		"source": "https://github.com/citomni/cli",
		"docs": "https://github.com/citomni/cli#readme"
	},
	"authors": [
		{
			"name": "Lars Grove Mortensen",
			"homepage": "https://www.citomni.com"
		}
	],
	"config": {
		"sort-packages": true,
		"optimize-autoloader": true
	},
	"archive": {
		"exclude": [
			"/.github",
			"/docs",
			"/tests",
			"/dev",
			"/examples",
			"/vendor",
			"/.editorconfig",
			"/.gitattributes",
			"/.gitignore",
			"/phpunit.xml*",
			"/.idea",
			"/.vscode",
			"/Makefile"
		]
	},
	"extra": {
		"branch-alias": {
			"dev-main": "1.0.x-dev"
		}
	}
}