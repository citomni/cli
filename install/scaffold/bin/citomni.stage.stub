/*
 *---------------------------------------------------------------
 * SCRIPT START TIME
 *---------------------------------------------------------------
 * Capture the start time as early as possible for runtime timing
 * and performance diagnostics.
 */
define('CITOMNI_START_NS', hrtime(true));


/*
 *---------------------------------------------------------------
 * APPLICATION ENVIRONMENT
 *---------------------------------------------------------------
 * This is the staging CLI entrypoint materialized by citomni/installer.
 * Switch environments with `citomni-installer environment <dev|stage|prod>`
 * rather than editing this file.
 *
 * Defined before the autoloader and the kernel, so that everything they load
 * sees the environment.
 */
define('CITOMNI_ENVIRONMENT', 'stage');


/*
 *---------------------------------------------------------------
 * APPLICATION PATHS & PUBLIC URL
 *---------------------------------------------------------------
 * CITOMNI_PUBLIC_PATH
 *   Absolute path to /public (no trailing slash).
 *
 * CITOMNI_APP_PATH
 *   Absolute path to the application root (one level above /bin).
 *
 * CITOMNI_PUBLIC_ROOT_URL
 *   Canonical staging base URL (no trailing slash), materialized by
 *   citomni/installer from STAGE_ROOT_URL. Available to shared code that builds
 *   absolute URLs from CLI, such as mails, links, and notifications.
 */
define('CITOMNI_PUBLIC_PATH', \dirname(__DIR__) . '/public');
define('CITOMNI_APP_PATH', \dirname(__DIR__));
define('CITOMNI_PUBLIC_ROOT_URL', '{{STAGE_ROOT_URL}}');


/*
 *---------------------------------------------------------------
 * COMPOSER AUTOLOAD
 *---------------------------------------------------------------
 * Load the application Composer autoloader. CitOmni and all other Composer
 * dependencies are installed below the application root.
 */
require CITOMNI_APP_PATH . '/vendor/autoload.php';


/*
 *---------------------------------------------------------------
 * CLI KERNEL
 *---------------------------------------------------------------
 * Hand the process to \CitOmni\Cli\Kernel::run(); its PHPDoc states what boot
 * does and which exit code the process ends with. Keep this entrypoint
 * deterministic and free of application logic.
 */
\CitOmni\Cli\Kernel::run(CITOMNI_APP_PATH . '/config', $_SERVER['argv'] ?? []);
