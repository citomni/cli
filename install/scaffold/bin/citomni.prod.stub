/*
 *---------------------------------------------------------------
 * SCRIPT START TIME
 *---------------------------------------------------------------
 * Capture the start time as early as possible for runtime timing
 * and performance diagnostics.
 */
define('CITOMNI_START_NS', hrtime(true));


/*
 *---------------------------------------------------------------
 * APPLICATION ENVIRONMENT
 *---------------------------------------------------------------
 * This is the production CLI entrypoint materialized by citomni/installer.
 * Switch environments with `citomni-installer environment <dev|stage|prod>`
 * rather than editing this file.
 *
 * The environment is defined before Composer and framework boot because it is
 * used while CitOmni resolves environment-specific configuration and command
 * maps, by framework behavior that distinguishes dev from stage/prod, and as
 * the default --env for cache:warm.
 */
define('CITOMNI_ENVIRONMENT', 'prod');


/*
 *---------------------------------------------------------------
 * APPLICATION PATHS & PUBLIC URL
 *---------------------------------------------------------------
 * CITOMNI_PUBLIC_PATH
 *   Absolute path to /public (no trailing slash).
 *
 * CITOMNI_APP_PATH
 *   Absolute path to the application root (one level above /bin).
 *
 * CITOMNI_PUBLIC_ROOT_URL
 *   Canonical production base URL (no trailing slash), materialized by
 *   citomni/installer from PROD_ROOT_URL. Available to shared code that builds
 *   absolute URLs from CLI, such as mails, links, and notifications.
 */
define('CITOMNI_PUBLIC_PATH', \dirname(__DIR__) . '/public');
define('CITOMNI_APP_PATH', \dirname(__DIR__));
define('CITOMNI_PUBLIC_ROOT_URL', '{{PROD_ROOT_URL}}');


/*
 *---------------------------------------------------------------
 * COMPOSER AUTOLOAD
 *---------------------------------------------------------------
 * Load the application Composer autoloader. CitOmni and all other Composer
 * dependencies are installed below the application root.
 */
require CITOMNI_APP_PATH . '/vendor/autoload.php';


/*
 *---------------------------------------------------------------
 * CLI KERNEL
 *---------------------------------------------------------------
 * The kernel:
 * - Boots the App in CLI mode, loading config, commands, and service definitions.
 * - Installs the CLI error handler when registered.
 * - Applies runtime locale, timezone, and charset configuration.
 * - Dispatches the requested command through the Runner.
 * - Exits with the command's exit code.
 *
 * Keep this entrypoint deterministic and free of application logic.
 */
\CitOmni\Cli\Kernel::run(CITOMNI_APP_PATH . '/config', $_SERVER['argv'] ?? []);
